{
  "name": "vite-plugin-vue-setup-name",
  "version": "0.0.8",
  "description": "Make the vue script setup syntax support the name attribute",
  "homepage": "https://github.com/lhlyu/vite-plugin-vue-setup-name",
  "bugs": {
    "url": "https://github.com/lhlyu/vite-plugin-vue-setup-name/issues"
  },
  "license": "MIT",
  "author": "lhlyu",
  "repository": "https://github.com/lhlyu/vite-plugin-vue-setup-name.git",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.40",
    "magic-string": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  }
}
