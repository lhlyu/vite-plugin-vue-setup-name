{
  "name": "vite-plugin-vue-setup-name",
  "version": "0.0.7",
  "description": "Make the vue script setup syntax support the name attribute",
  "homepage": "https://github.com/lhlyu/vite-plugin-vue-setup-name",
  "bugs": {
    "url": "https://github.com/lhlyu/vite-plugin-vue-setup-name/issues"
  },
  "license": "MIT",
  "author": "lhlyu",
  "repository": "https://github.com/lhlyu/vite-plugin-vue-setup-name.git",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "dev": "unbuild --stub",
    "build": "unbuild",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.30",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "unbuild": "^3.6.1",
    "vite": "^8.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  }
}
